{
  "cleanUrls": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/sobre.html", "destination": "/sobre/", "permanent": true },
    { "source": "/sobre", "destination": "/sobre/", "permanent": true },
    { "source": "/servicos.html", "destination": "/servicos/", "permanent": true },
    { "source": "/servicos", "destination": "/servicos/", "permanent": true },
    { "source": "/contato.html", "destination": "/contato/", "permanent": true },
    { "source": "/contato", "destination": "/contato/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|css|js)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
